# Copy this to ".env" on the server (next to docker-compose.yml), fill in
# real values. Never commit the real .env — it's already gitignored.

POSTGRES_PASSWORD=choose-a-strong-password-here
LLM_API_KEY=your-groq-api-key
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
BASE_URL=https://your-subdomain.duckdns.org
DOMAIN=your-subdomain.duckdns.org
